# Copy of .env.example for production builds: fill in the real deployment host.
VITE_OAUTH_AUTHORITY=https://auth.arorms.cn/realms/arorms
# Keycloak client is still registered as `frontend-template`; rename it there first
VITE_OAUTH_CLIENT_ID=frontend-template
VITE_OAUTH_REDIRECT_URI=https://playground.arorms.cn/callback
VITE_API_BASE_URL=/api
